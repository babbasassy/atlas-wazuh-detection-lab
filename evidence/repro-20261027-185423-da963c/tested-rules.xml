<group name="atlas_windows,">
  <rule id="100100" level="5">
    <if_sid>60122</if_sid>
    <field name="win.system.channel" type="pcre2">^Security$</field>
    <field name="win.system.providerName" type="pcre2">^Microsoft-Windows-Security-Auditing$</field>
    <field name="win.system.eventID" type="pcre2">^4625$</field>
    <field name="win.eventdata.logonType" type="pcre2">^3$</field>
    <description>ATLAS: Failed network logon; investigate context, not proof of brute force.</description>
    <group>authentication_failed,</group>
  </rule>
  <rule id="100110" level="7">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(?:powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(?:^|\s)-(?:enc|encodedcommand)\s+\S+</field>
    <description>ATLAS: PowerShell encoded command argument; review payload and parent process.</description>
    <group>atlas_encoded_powershell,</group>
  </rule>
  <rule id="100120" level="7">
    <if_sid>61613</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\[^\\]+\.lnk$</field>
    <description>ATLAS: Shortcut created in a Windows Startup folder; validate authorized software.</description>
    <group>atlas_startup_shortcut,</group>
  </rule>
</group>
